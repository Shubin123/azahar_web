+    bool has_second_source{};
+
+    bool DestComponentEnabled(int component) const {
+        return (dest_mask & (0x8u >> component)) != 0;
+    }
+};
+
+struct InterpreterCache {
+    std::array<DecodedInstruction, MAX_PROGRAM_CODE_LENGTH> instructions{};
