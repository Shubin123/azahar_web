+static thread_local std::unordered_map<const ShaderSetup*, InterpreterCache> interpreter_caches;
+
+static inline f24 Multiply(f24 lhs, f24 rhs) {
+#ifdef __EMSCRIPTEN__
+    // The web wrapper runs with shaders_accurate_mul disabled. Avoid the
+    // float24 helper's two isnan checks for every vertex-shader multiply; the
+    // checks only affect the PICA-specific infinity-times-zero edge case.
+    return f24::FromFloat32(lhs.ToFloat32() * rhs.ToFloat32());
+#else
+    return lhs * rhs;
+#endif
+}
+
+template <typename Operation>
+static inline void WriteMasked(f24* dest, u8 mask, Operation&& operation) {
+    // xyzw is by far the most common PICA destination mask. Keep that path
+    // branch-free and only pay per-component mask tests for partial writes.
+    if (mask == 0xF) {
+        dest[0] = operation(0);
+        dest[1] = operation(1);
+        dest[2] = operation(2);
+        dest[3] = operation(3);
+        return;
+    }
+    for (int component = 0; component < 4; ++component) {
+        if (mask & (0x8u >> component)) {
+            dest[component] = operation(component);
+        }
+    }
+}
