{
  "name": "azahar_web",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling, web frontend, and browser test harness for the Azahar WebAssembly port.",
  "type": "commonjs",
  "scripts": {
    "test": "node tests/run.cjs",
    "test:library": "node tests/game_library.test.cjs && node tests/library_replay.test.cjs",
    "test:input": "node tests/input_ui.test.cjs",
    "library:generate": "python3 scripts/generate_games_library.py",
    "smoke": "node tests/web_artifact_smoke.cjs",
    "bench": "node tests/benchmark_browser.cjs",
    "test:audio": "node tests/audio.test.cjs",
    "test:renderer-recovery": "node tests/renderer_recovery.test.cjs",
    "test:local-play": "node tests/local_play.test.cjs && node tests/public_lobbies.test.cjs",
    "test:multiplayer": "node tests/multiplayer.test.cjs --link-smoke && node tests/multiplayer.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shubin123/azahar_web.git"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
