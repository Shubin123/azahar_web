# Azahar Web Emulator - .gitignore

# Repository-local toolchains installed by setup_web_toolchain.sh
/.toolchains/

# Build directories
/build-*/

# Temporary/test directories
/tmp_test/
/_test_cmake/
/_to_delete/

# Local ROM/test data (large and license-sensitive)
/test_games/

# Generated test reports and benchmarks
/tests/benchmark_results.json
/tests/e2e/test_results.json
/tests/e2e/latest_run.tap

# Logs and temp output
*.log
bench_*.txt
build_*.txt
configure_*.txt
regression_*.txt

# Agent/editor/local environment state
/.agents/
/.codex/
.vscode/
.idea/
*.swp
*.pyc
__pycache__/
node_modules/

# OS files
Thumbs.db
.DS_Store
