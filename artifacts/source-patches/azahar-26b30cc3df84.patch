+/// Write performance counters into a caller-allocated buffer of 8 doubles.
+/// Returns 0 on success, negative on error.
+/// Buffer layout (8 × f64):
+///   [0] game_fps        — GSP frame submissions per second
+///   [1] system_fps      — LCD VBlank events per second
+///   [2] emulation_speed — walltime / emulated-time ratio (1.0 = full speed)
+///   [3] time_gpu        — wall seconds per vblank spent in GPU processing
+///   [4] time_swap       — wall seconds per vblank spent presenting
+///   [5] time_vblank     — total wall seconds per vblank interval
+///   [6] mean_frametime  — arithmetic mean of frametimes in the history ring
+///   [7] frame_limit_pct — active frame-limit percentage (0 = unlimited)
+extern "C" int azahar_get_perf_stats(double* out_buffer, int buffer_size) {
+    if (!out_buffer || buffer_size < 8) {
+        return -1;
+    }
