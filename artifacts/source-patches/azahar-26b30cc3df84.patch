+
+# Emscripten WebAssembly executable target
+if (EMSCRIPTEN)
+    add_executable(azahar_web
+        emscripten_main.cpp
+    )
+    target_link_libraries(azahar_web PRIVATE citra_sdl citra_common citra_core input_common network)
+    target_link_libraries(azahar_web PRIVATE inih SDL2::SDL2 Threads::Threads)
+    set_target_properties(azahar_web PROPERTIES
+        OUTPUT_NAME "azahar"
+        SUFFIX ".html"
+    )
+    # Emscripten-specific linker flags
+    target_link_options(azahar_web PRIVATE
+        # Enable SharedArrayBuffer-backed POSIX threads.  Keep this legacy
+        # setting alongside -pthread (from Threads::Threads) for the Unity
+        # Emscripten toolchain used by the web build.
+        -sUSE_PTHREADS=1
+        # The core can create worker threads while a synchronous JS export is
+        # still running.  Pre-create workers so pthread_create does not need
+        # to wait for a subsequent browser event-loop turn.
+        # Shader-cache warmup can create one worker per reported CPU, in
+        # addition to the emulator's long-lived service threads.  Eight
+        # workers is therefore insufficient even for a modest desktop
+        # browser and Emscripten cannot synchronously grow this pool while a
+        # WASM export is active.
+        -sPTHREAD_POOL_SIZE=32
+        -sINITIAL_MEMORY=512MB
+        -sSTACK_SIZE=2MB
+        -sALLOW_MEMORY_GROWTH=1
+        # The provided .3ds workload is a full 2 GiB cartridge image. Leave
+        # address space for it and the emulator rather than stopping at
+        # Emscripten's 2 GiB default growth limit.
+        -sMAXIMUM_MEMORY=4GB
+        # Keep browser failures actionable during the web-port validation
+        # phase.  Without this, a wasm trap is reported only as
+        # "Aborted(undefined)", which cannot distinguish an assertion from a
+        # loader or allocation failure.
+        -sASSERTIONS=2
+        # The desktop loader uses C++ exceptions for recoverable file and
+        # allocation failures.  Emscripten otherwise aborts as soon as one is
+        # thrown, before the caller can report a ResultStatus.
+        -sNO_DISABLE_EXCEPTION_CATCHING=1
+        -sUSE_SDL=2
+        "-sEXPORTED_FUNCTIONS=['_azahar_init','_azahar_load_rom','_azahar_step_frame','_azahar_framebuffer_nonblack_pixels','_azahar_shutdown','_azahar_run_loop','_malloc','_free','_emscripten_resize_heap']"
+        "-sEXPORTED_RUNTIME_METHODS=['ccall','cwrap','FS','HEAPU8','HEAP32']"
+        -sNO_EXIT_RUNTIME=1
+    )
+endif()
diff --git a/src/citra_sdl/emscripten_main.cpp b/src/citra_sdl/emscripten_main.cpp
new file mode 100644
index 000000000..b5f5e0cfa
--- /dev/null
+++ b/src/citra_sdl/emscripten_main.cpp
@@ -0,0 +1,290 @@
+// Copyright Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Emscripten/WebAssembly entry point — replaces citra_sdl.cpp main for web builds.
+
+#include <cstring>
+#include <memory>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <emscripten/html5.h>
+#endif
+
+#include "citra_sdl/config.h"
+#include "citra_sdl/emu_window/emu_window_sdl2.h"
+#ifdef ENABLE_SOFTWARE_RENDERER
+#include "citra_sdl/emu_window/emu_window_sdl2_sw.h"
+#endif
+#include "common/file_util.h"
+#include "common/logging/backend.h"
+#include "common/logging/log.h"
+#include "common/scm_rev.h"
+#include "common/settings.h"
+#include "core/core.h"
+#include "core/frontend/applets/default_applets.h"
+#include "core/hle/service/service.h"
+#include "video_core/gpu.h"
+#include "video_core/renderer_base.h"
+#ifdef ENABLE_SOFTWARE_RENDERER
+#include "video_core/renderer_software/renderer_software.h"
+#endif
+
+namespace {
+
+Core::System* g_system = nullptr;
+std::unique_ptr<EmuWindow_SDL2> g_emu_window;
+bool g_initialized = false;
+bool g_rom_loaded = false;
+
+} // anonymous namespace
+
+/// One-time initialization of the emulator core and software renderer window.
+/// Returns 0 on success, non-zero on failure.
+extern "C" int azahar_init() {
+    if (g_initialized) {
+        LOG_WARNING(Frontend, "azahar_init called but already initialized");
+        return 0;
+    }
+
+    Common::Log::Initialize();
+    Common::Log::SetColorConsoleBackendEnabled(true);
+    Common::Log::Start();
+
+    LOG_INFO(Frontend, "Azahar WebAssembly {} | {}-{}", Common::g_build_fullname,
+             Common::g_scm_branch, Common::g_scm_desc);
+
+    g_system = &Core::System::GetInstance();
+
+    // Load the standard SDL defaults so every setting that System::Load and
+    // the HLE services expect has a defined value. This is the same frontend
+    // setup the native SDL entry point performs; the generated INI remains in
+    // MEMFS for this browser session.
+    SdlConfig web_config;
+
+    // Override desktop-only defaults after loading the configuration.
+    Settings::values.graphics_api.SetValue(Settings::GraphicsAPI::Software);
+    Settings::values.use_cpu_jit.SetValue(false);
+
+    // The SDL and Qt frontends populate this map while loading their config
+    // files.  The web frontend has no config file, but Service::Init still
+    // performs a lookup for every module.  Populate the desktop defaults
+    // explicitly so normal HLE services are selected instead of throwing
+    // std::out_of_range from unordered_map::at during game load.
+    Settings::values.lle_modules.clear();
+    for (const auto& service_module : Service::service_module_map) {
+        Settings::values.lle_modules.emplace(service_module.name, false);
+    }
+
+    // Match the native SDL frontend's initialization order. In particular,
+    // ApplySettings configures the core before System::Load constructs the
+    // GPU and emulated services for the selected title.
+    g_system->ApplySettings();
+
+#ifdef ENABLE_SOFTWARE_RENDERER
+    Frontend::RegisterDefaultApplets(*g_system);
+    EmuWindow_SDL2::InitializeSDL2();
+
+    // Create the software-rendered window (no fullscreen on web, not secondary)
+    g_emu_window = std::make_unique<EmuWindow_SDL2_SW>(*g_system, false, false);
+#else
+    LOG_CRITICAL(Frontend, "Software renderer not enabled in this build!");
+    return -1;
+#endif
+
+    g_initialized = true;
+    LOG_INFO(Frontend, "azahar_init OK");
+    return 0;
+}
+
+/// Load a ROM file from the given MEMFS path.
+/// Returns 0 on success, non-zero on failure.
+extern "C" int azahar_load_rom(const char* path) {
+    if (!g_initialized || !g_system || !g_emu_window) {
+        LOG_CRITICAL(Frontend, "azahar_load_rom: not initialized");
+        return -1;
+    }
+
+    if (!path || !path[0]) {
+        LOG_CRITICAL(Frontend, "azahar_load_rom: empty path");
+        return -4;
+    }
+
+    if (std::strlen(path) >= 4096) {
+        LOG_CRITICAL(Frontend, "azahar_load_rom: path length exceeds limit");
+        return -5;
+    }
+
+    if (!FileUtil::Exists(path)) {
+        LOG_CRITICAL(Frontend, "File does not exist: {}", path);
+        return -4;
+    }
+
+    FileUtil::IOFile check_file(path, "rb");
+    if (check_file.GetSize() == 0) {
+        LOG_CRITICAL(Frontend, "File is empty: {}", path);
+        return -3;
+    }
+
+    LOG_INFO(Frontend, "Loading ROM from: {}", path);
+
+    const auto scope = g_emu_window->Acquire();
+
+    const Core::System::ResultStatus load_result{
+        g_system->Load(*g_emu_window, std::string(path))};
+
+    switch (load_result) {
+    case Core::System::ResultStatus::Success:
+        g_rom_loaded = true;
+        LOG_INFO(Frontend, "azahar_load_rom OK");
+        return 0;
+    case Core::System::ResultStatus::ErrorGetLoader:
+        LOG_CRITICAL(Frontend, "Failed to obtain loader for {}!", path);
+        return -3;
+    case Core::System::ResultStatus::ErrorLoader:
+        LOG_CRITICAL(Frontend, "Failed to load ROM!");
+        return -3;
+    case Core::System::ResultStatus::ErrorLoader_ErrorEncrypted:
+        LOG_CRITICAL(Frontend, "ROM is encrypted and must be decrypted first.");
+        return -4;
+    case Core::System::ResultStatus::ErrorLoader_ErrorInvalidFormat:
+        LOG_CRITICAL(Frontend, "ROM format is not supported.");
+        return -3;
+    default:
+        LOG_ERROR(Frontend, "Error loading ROM: {}", g_system->GetStatusDetails());
+        return -6;
+    }
+}
+
+/// Step one emulation frame: run the CPU loop, render, and present.
+/// Returns 0 on success, negative on error, 1 if shutdown was requested.
+extern "C" int azahar_step_frame() {
+    if (!g_initialized || !g_system || !g_emu_window) {
+        return -1;
+    }
+
+    if (!g_rom_loaded) {
+        return -2;
+    }
+
+    // Poll SDL events (required for Emscripten SDL event pump)
+    g_emu_window->PollEvents();
+
+    if (!g_emu_window->IsOpen()) {
+        return 1; // shutdown requested
+    }
+
+    // A single RunLoop slice advances only a small amount of emulated time.
+    // The JavaScript UI yields for roughly one display interval between calls,
+    // so doing just one here caps dyncom at a few percent of normal speed.
+    // Batch slices for a bounded portion of each browser tick: this gives the
+    // interpreter enough work to reach a title screen while preserving a
+    // regular opportunity for the browser to process input and paint.
+    Core::System::ResultStatus result = Core::System::ResultStatus::Success;
+#ifdef __EMSCRIPTEN__
+    constexpr int max_slices_per_tick = 16;
+    const double deadline_ms = emscripten_get_now() + 12.0;
+    for (int slice = 0; slice < max_slices_per_tick && emscripten_get_now() < deadline_ms;
+         ++slice) {
+        result = g_system->RunLoop();
+        if (result != Core::System::ResultStatus::Success) {
+            break;
+        }
+    }
+#else
+    result = g_system->RunLoop();
+#endif
+
+    switch (result) {
+    case Core::System::ResultStatus::ShutdownRequested:
+        g_emu_window->RequestClose();
+        return 1;
+    case Core::System::ResultStatus::Success:
+        break;
+    default:
+        LOG_ERROR(Frontend, "Error in run loop: {}", g_system->GetStatusDetails());
+        return -3;
+    }
+
+    // Present single frame (non-blocking for Emscripten)
+    g_emu_window->Present();
+
+    return 0;
+}
+
+/// Return the number of non-black pixels held by the software renderer's
+/// primary displays. This is intentionally small diagnostic surface for the
+/// browser regression: it separates core rendering failures from SDL/canvas
+/// presentation failures without copying a framebuffer into JavaScript.
+extern "C" int azahar_framebuffer_nonblack_pixels() {
+#ifdef ENABLE_SOFTWARE_RENDERER
+    if (!g_initialized || !g_system) {
+        return -1;
+    }
+
+    const auto& renderer = static_cast<const SwRenderer::RendererSoftware&>(g_system->GPU().Renderer());
+    int nonblack_pixels{};
+    for (const auto screen_id : {VideoCore::ScreenId::TopLeft, VideoCore::ScreenId::Bottom}) {
+        const auto& pixels = renderer.Screen(screen_id).pixels;
+        for (std::size_t offset = 0; offset + 3 < pixels.size(); offset += 4) {
+            if (pixels[offset] || pixels[offset + 1] || pixels[offset + 2]) {
+                ++nonblack_pixels;
+            }
+        }
+    }
+    return nonblack_pixels;
+#else
+    return -1;
+#endif
+}
+
+/// Shut down the emulator and free resources.
+extern "C" void azahar_shutdown() {
+    LOG_INFO(Frontend, "azahar_shutdown");
+
+    if (g_emu_window) {
+        g_emu_window.reset();
+    }
+
+    if (g_system) {
+        g_system->Shutdown();
+    }
+
+    Common::Log::Stop();
+
+    g_initialized = false;
+    g_rom_loaded = false;
+    g_system = nullptr;
+}
+
+#ifdef __EMSCRIPTEN__
+/// Emscripten main loop callback — steps one frame per invocation.
+/// Registered via emscripten_set_main_loop when using the event-loop model.
+static void emscripten_main_loop_callback() {
+    int result = azahar_step_frame();
+    if (result != 0) {
+        if (result == 1) {
+            LOG_INFO(Frontend, "Emulation ended (shutdown requested)");
+        } else {
+            LOG_ERROR(Frontend, "Frame step error: {}", result);
+        }
+        emscripten_cancel_main_loop();
+        azahar_shutdown();
+    }
+}
+
+/// Start the emulator with Emscripten's built-in main loop.
+/// Alternative to calling azahar_step_frame() manually from JS.
+/// The ROM must already be loaded via azahar_load_rom().
+extern "C" int azahar_run_loop() {
+    if (!g_rom_loaded) {
+        LOG_CRITICAL(Frontend, "azahar_run_loop: no ROM loaded");
+        return -1;
+    }
+
+    LOG_INFO(Frontend, "Starting Emscripten main loop");
+    // 0 FPS = use requestAnimationFrame (browser vsync)
+    // 1 = simulate infinite loop so emscripten doesn't yield to browser
+    emscripten_set_main_loop(emscripten_main_loop_callback, 0, 1);
+    return 0;
+}
+#endif // __EMSCRIPTEN__
