+    // A one-task-per-scanline strategy spends substantial time contending on
+    // the shared worker queue for small triangles. Rows do not overlap in the
+    // framebuffer, so process a short contiguous row band per task instead.
+    constexpr u16 scanlines_per_task = 4;
+    constexpr u16 rasterizer_pixel_step = 0x10;
+    for (u16 y_begin = min_y + 8; y_begin < max_y;
+         y_begin += rasterizer_pixel_step * scanlines_per_task) {
+        const u16 y_end = std::min<u16>(
+            max_y, static_cast<u16>(y_begin + rasterizer_pixel_step * scanlines_per_task));
+        const auto process_row_band = [&, y_begin, y_end] {
+            for (u16 y = y_begin; y < y_end; y += rasterizer_pixel_step) {
+                for (u16 x = min_x + 8; x < max_x; x += rasterizer_pixel_step) {
                 // Do not process the pixel if it's inside the scissor box and the scissor mode is
